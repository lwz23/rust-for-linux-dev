+    // Export Clang types that are only sugar or attributes as ParenType.
+    // The type-table key must be this type object; the inner type is what
+    // the translator uses.
+    void encodeTransparentSugar(const clang::Type *T, QualType inner) {
+        if (inner.isNull() || inner.getTypePtr() == T)
+            inner = Context->IntTy;
+        auto qt = encodeQualType(inner);
+        encodeType(T, TagParenType,
+                   [qt](CborEncoder *local) { cbor_encode_uint(local, qt); });
+        VisitQualType(inner);
+    }
+
+    void VisitAutoType(const AutoType *T) {
+        encodeTransparentSugar(T, T->getDeducedType());
+    }
+
+    void VisitCountAttributedType(const CountAttributedType *T) {
+        encodeTransparentSugar(T, T->desugar());
+    }
+
+    void VisitBTFTagAttributedType(const BTFTagAttributedType *T) {
+        encodeTransparentSugar(T, T->desugar());
+    }
+
+    void VisitMacroQualifiedType(const MacroQualifiedType *T) {
+        encodeTransparentSugar(T, T->desugar());
+    }
+
+    void VisitBitIntType(const BitIntType *T) {
+        QualType inner;
+        unsigned bits = T->getNumBits();
+        if (bits <= 8)
+            inner = T->isUnsigned() ? Context->UnsignedCharTy : Context->SignedCharTy;
+        else if (bits <= 16)
+            inner = T->isUnsigned() ? Context->UnsignedShortTy : Context->ShortTy;
+        else if (bits <= 32)
+            inner = T->isUnsigned() ? Context->UnsignedIntTy : Context->IntTy;
+        else
+            inner = T->isUnsigned() ? Context->UnsignedLongLongTy : Context->LongLongTy;
+        encodeTransparentSugar(T, inner);
+    }
+
+    void VisitArrayParameterType(const ArrayParameterType *T) {
+        VisitConstantArrayType(T);
+    }
+
+    void VisitExtVectorType(const ExtVectorType *T) {
+        VisitVectorType(T);
+    }
+
 };
 
